{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/domain/**/*.ts",
    "src/app/**/*.ts",
    "src/renderer/src/**/*.ts",
    "src/renderer/*.html"
  ]
}
