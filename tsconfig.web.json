{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": [
    "src/contracts/**/*.ts",
    "src/domain/**/*.ts",
    "src/shared/**/*.ts",
    "src/app/**/*.ts",
    "src/adapters/presentation/**/*.ts",
    "src/adapters/bridge/**/*.ts",
    "src/entries/preload.ts",
    "src/entries/renderer.ts",
    "src/entries/env.d.ts",
    "src/renderer/*.html"
  ]
}
