{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/contracts/**/*.ts",
    "src/domain/**/*.ts",
    "src/app/**/*.ts",
    "src/adapters/shell/**/*.ts",
    "src/adapters/brain/**/*.ts",
    "src/entries/main.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "electron.vite.config.ts"
  ]
}
